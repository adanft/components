{
  "name": "components-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:highlighted-code && pnpm exec vite",
    "build": "pnpm generate:highlighted-code:check && pnpm typecheck && pnpm exec vite build",
    "generate:highlighted-code": "node scripts/generate-highlighted-code.mjs",
    "generate:highlighted-code:check": "node scripts/generate-highlighted-code.mjs --check",
    "preview": "pnpm exec vite preview",
    "test": "pnpm generate:highlighted-code:check && pnpm exec vitest run --config vitest.config.ts",
    "typecheck": "pnpm exec tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@adanft/ui": "workspace:*",
    "lucide-react": "1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
